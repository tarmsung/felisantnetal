# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored by default (see .gitignore) — never commit
# real credentials.

# --- Supabase --------------------------------------------------------
# From your Supabase project: Project Settings -> API.
# NEXT_PUBLIC_* values are safe to ship to the browser: the anon key
# only ever grants what RLS (supabase/migrations/*_rls_policies.sql)
# allows. SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — it must
# never be prefixed with NEXT_PUBLIC_ and must never reach client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, only needed if you run migrations
# with a generic SQL tool instead of the Supabase SQL editor / CLI.
DATABASE_URL=

# --- WhatsApp notifications (spec section 9, Phase 5) -------------------
# Which NotificationProvider actually sends (lib/services/notifications/)
# is chosen in-app, at Settings -> Notifications (notification_settings.
# whatsapp_provider) — administrator-configurable there, not by an env
# var, so switching providers doesn't need a redeploy. These two are
# only read by the "baileys" provider, to reach the separate
# whatsapp-service (see that directory's README, including its ban-risk
# disclosure, before pairing a real clinic number). Leave both unset to
# stay on the "console" provider (logs instead of sending).
WHATSAPP_SERVICE_URL=http://localhost:3100
WHATSAPP_SERVICE_API_KEY=

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret the reminder cron endpoint checks for (see spec section
# 27) so it can't be triggered by an arbitrary public request.
CRON_SECRET=

# --- Local bootstrap (scripts/seed.ts) ---------------------------------
# Used once, to create the very first administrator account. Not read
# by the running application itself.
SEED_ADMIN_NAME=Clinic Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- E2E test accounts (e2e/helpers.ts, Phase 10) -----------------------
# Only read by `npm run test:e2e`, never by the running app. MUST be
# real but disposable staff accounts — created via the app's own Users
# module or scripts/seed.ts — distinct from any account a real clinic
# staff member signs in with. Several specs create/modify data through
# them; see README.md "Running tests" before pointing these at a
# project you're not comfortable seeding and cleaning up against.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_NURSE_EMAIL=
E2E_NURSE_PASSWORD=
